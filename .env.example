# GridMind AI Environment Variables
# Copy this file to .env and add your free API keys.
# If no keys are provided, GridMind automatically uses the deterministic mock adapter.

# Primary AI (Google Gemini free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fallback AI 1 (OpenRouter key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Fallback AI 2 (Groq free key from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Anthropic Claude key
ANTHROPIC_API_KEY=

# Adapter mode: auto | gemini | openrouter | groq | anthropic | mock
GRIDMIND_AI_PROVIDER=auto

# Optional Supabase (for cloud Postgres + OTP Auth; demo mode works locally without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Local backend URL used by Next.js BFF proxy
FASTAPI_URL=http://127.0.0.1:8000

